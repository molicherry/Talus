# Talus — deployment defaults
# Copy to .env. Required: DB_PASSWORD, VPSMANAGER_MASTER_KEY, JWT_SECRET.
# The 19 settings below may also be saved by an administrator at /settings.
# Priority: saved settings > deployment environment > application defaults.
# Restore deployment configuration in the UI removes that saved override.
# See docs/system-settings.zh-CN.md and the README Configuration section.

DB_PASSWORD=
# Generate both secrets separately with: openssl rand -hex 32
# Preserve the master key across upgrades and database restores.
VPSMANAGER_MASTER_KEY=
JWT_SECRET=
# Published host port; the bundled Compose Hub listens on 8080 internally.
PORT=8080
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Monitoring — Settings > Monitoring. May be filled after first login.
# Use the Hub HTTPS address reachable FROM managed nodes; blank skips installation.
AGENT_HUB_URL=
MONITOR_INTERVAL=5
# Advanced: allow HTTP only for trusted private/test networks.
AGENT_ALLOW_HTTP=false

# SSH — Settings > SSH. New operations / next idle eviction.
SSH_TIMEOUT=10
SSH_MAX_IDLE=300

# Commands — Settings > Command execution. Seconds and bytes.
# Each command can request a timeout, capped by EXEC_TIMEOUT_MAX.
EXEC_TIMEOUT=30
EXEC_TIMEOUT_MAX=300
EXEC_OUTPUT_LIMIT=8388608
EXEC_OUTPUT_STREAM_LIMIT=4194304

# Retention — Settings > Data retention. Next cleanup cycle.
USAGE_LOG_RETENTION_DAYS=30
USAGE_LOG_SENSITIVE_RETENTION_DAYS=90
# Actual metric deletion requires enabled=true AND dry_run=false.
METRICS_RETENTION_ENABLED=false
METRICS_RETENTION_DRY_RUN=true

# Settings > Login protection / Application logs. Apply live.
LOGIN_RATE_LIMIT=10
LOG_LEVEL=info
LOG_FORMAT=json

# Settings > Capacity (advanced). Saved changes require a Hub restart.
DB_MAX_OPEN_CONNECTIONS=32
USAGE_LOG_WRITE_CONCURRENCY=4
USAGE_LOG_ACTIVE_LIMIT=4096

# Upgrade-only operator assertion, not an ordinary system setting.
# Set true ONLY after all legacy instances and their transactions have stopped.
# Enables historical audit-log backfill; remove after completion is confirmed.
USAGE_LOG_LEGACY_WRITERS_DRAINED=false

# These are already set by the bundled Compose/image. Custom process/container
# deployments may override them in the Hub environment, with matching mounts:
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=disable
# AGENT_ARTIFACTS_DIR=/usr/local/bin
# STATIC_DIR=/app/static
# Deprecated compatibility variables (not used for resident Agent freshness):
# MONITOR_TOLERATED_ROUNDS=1
# MONITOR_ALLOWED_LATENCY_SECONDS=0
