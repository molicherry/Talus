# VPS Manager — Environment Variables
# Copy this file to .env and fill in the values. The stack refuses to start
# until DB_PASSWORD, VPSMANAGER_MASTER_KEY, and JWT_SECRET are set.

# Database password for PostgreSQL
DB_PASSWORD=

# Random master key for encrypted credentials (32+ bytes, hex-encoded)
# Keep this value unchanged when upgrading the Hub or restoring its database.
# Generate with: openssl rand -hex 32
VPSMANAGER_MASTER_KEY=

# JWT signing secret (any random string)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# HTTP server port (default: 8080)
PORT=8080

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# SSH connection timeout in seconds (default: 10)
SSH_TIMEOUT=10

# Resident monitoring: address reachable FROM the managed Linux servers.
# HTTPS is required by default; no additional inbound port is opened on nodes.
AGENT_HUB_URL=https://talus.example.com
AGENT_ALLOW_HTTP=false
MONITOR_INTERVAL=5

# Command execution timeout in seconds (default: 30)
EXEC_TIMEOUT=30

# Usage logs: bounded summary capture and retention
DB_MAX_OPEN_CONNECTIONS=32
USAGE_LOG_WRITE_CONCURRENCY=4
USAGE_LOG_ACTIVE_LIMIT=4096
USAGE_LOG_RETENTION_DAYS=30
USAGE_LOG_SENSITIVE_RETENTION_DAYS=90
# Enable only after every legacy instance and its transactions have drained.
USAGE_LOG_LEGACY_WRITERS_DRAINED=false
