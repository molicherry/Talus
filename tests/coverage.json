{
  "schema_version": 1,
  "runs": [
    {
      "run_id": "coverage-tools",
      "suite": "fast",
      "runner": "node-test",
      "cwd": ".",
      "command": [
        "node",
        "tests/render-coverage.mjs",
        "--check"
      ],
      "timeout_seconds": 120,
      "environment": {
        "profile": "local",
        "requires": []
      }
    },
    {
      "run_id": "static-adapters",
      "suite": "fast",
      "runner": "shell",
      "cwd": ".",
      "command": [
        "bash",
        "tests/static/adapters-removed.sh"
      ],
      "timeout_seconds": 120,
      "environment": {
        "profile": "local",
        "requires": []
      }
    },
    {
      "run_id": "go-unit",
      "suite": "fast",
      "runner": "go-test",
      "cwd": "backend",
      "command": [
        "go",
        "test",
        "./..."
      ],
      "timeout_seconds": 600,
      "environment": {
        "profile": "local",
        "requires": []
      }
    },
    {
      "run_id": "frontend-node",
      "suite": "fast",
      "runner": "node-test",
      "cwd": "frontend",
      "command": [
        "bash",
        "tests/run.sh"
      ],
      "timeout_seconds": 600,
      "environment": {
        "profile": "local",
        "requires": []
      }
    },
    {
      "run_id": "migrate-hardening",
      "suite": "integration",
      "runner": "go-test",
      "cwd": "backend",
      "command": [
        "go",
        "test",
        "./internal/repository/...",
        "-run",
        "ApplyOnce",
        "-count=1"
      ],
      "timeout_seconds": 600,
      "environment": {
        "profile": "isolated-db",
        "requires": [
          "TEST_DATABASE_URL"
        ]
      }
    },
    {
      "run_id": "integration-agent",
      "suite": "integration",
      "runner": "go-test",
      "cwd": "backend",
      "command": [
        "go",
        "test",
        "./internal/service/...",
        "-run",
        "Agent",
        "-count=1"
      ],
      "timeout_seconds": 600,
      "environment": {
        "profile": "isolated-db",
        "requires": [
          "TEST_DATABASE_URL"
        ]
      }
    },
    {
      "run_id": "ui-charts",
      "suite": "ui",
      "runner": "playwright",
      "cwd": "frontend",
      "command": [
        "npm",
        "run",
        "test:ui"
      ],
      "timeout_seconds": 900,
      "environment": {
        "profile": "browser-mock",
        "requires": [
          "playwright"
        ]
      }
    },
    {
      "run_id": "e2e-core",
      "suite": "e2e",
      "runner": "shell",
      "cwd": ".",
      "command": [
        "bash",
        "tests/e2e/run.sh"
      ],
      "timeout_seconds": 1200,
      "environment": {
        "profile": "real-hub",
        "requires": [
          "TEST_HUB_URL",
          "TEST_DATABASE_URL"
        ]
      }
    },
    {
      "run_id": "deploy-verify",
      "suite": "integration",
      "runner": "manual",
      "cwd": ".",
      "command": null,
      "timeout_seconds": null,
      "environment": {
        "profile": "tx-deploy",
        "requires": []
      }
    }
  ],
  "gates": {
    "M1": [
      "coverage-tools",
      "static-adapters",
      "go-unit",
      "frontend-node",
      "migrate-hardening",
      "deploy-verify"
    ],
    "M2": [
      "coverage-tools",
      "static-adapters",
      "go-unit",
      "frontend-node",
      "migrate-hardening",
      "integration-agent"
    ],
    "M3": [
      "go-unit",
      "frontend-node",
      "migrate-hardening",
      "integration-agent",
      "ui-charts"
    ],
    "M4": [
      "go-unit",
      "frontend-node",
      "ui-charts",
      "e2e-core"
    ]
  },
  "phases": {
    "M1": [
      "REQ-01",
