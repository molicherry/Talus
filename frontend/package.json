{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "bash tests/run.sh",
    "test:ui": "npm run build && npm run test:ui:built",
    "test:ui:built": "node tests/ui-regressions.browser.mjs && node tests/usage-logs.browser.mjs && node tests/terminal.browser.mjs && node tests/files.browser.mjs && node tests/settings.browser.mjs && node tests/bootstrap.browser.mjs",
    "test:usage-ui": "npm run build && node tests/usage-logs.browser.mjs",
    "test:settings-ui": "npm run build && node tests/settings.browser.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@noble/hashes": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
